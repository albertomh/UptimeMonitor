{
    "name": "uptime-monitor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev --local --host src/index.ts --test-scheduled",
        "test": "vitest run",
        "deploy": "wrangler deploy src/index.ts",
        "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=esm --minify --loader:.txt=text",
        "d1:local:init": "wrangler d1 execute DB --local --file=schema.sql",
        "d1:local:seed": "wrangler d1 execute DB --local --file=seed.sql",
        "d1:local:reset": "rm -rf .wrangler/state && wrangler d1 execute DB --local --file=schema.sql && wrangler d1 execute DB --local --file=seed.sql",
        "types": "wrangler types"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.127.0"
    },
    "packageManager": "pnpm@11.24.0"
}
