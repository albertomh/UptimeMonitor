{
    "name": "uptime-worker",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev --config .config/wrangler.jsonc --local --host src/index.ts --test-scheduled",
        "test": "vitest run --config .config/vitest.config.ts",
        "deploy": "wrangler deploy --config .config/wrangler.jsonc src/index.ts",
        "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=esm --minify --loader:.txt=text",
        "d1:local:init": "wrangler d1 execute DB --config .config/wrangler.jsonc --local --file=src/db/schema.sql",
        "d1:local:seed": "wrangler d1 execute DB --config .config/wrangler.jsonc --local --file=src/db/seed.sql",
        "d1:local:reset": "rm -rf .wrangler/state && wrangler d1 execute DB --config .config/wrangler.jsonc --local --file=src/db/schema.sql && wrangler d1 execute DB --config .config/wrangler.jsonc --local --file=src/db/seed.sql",
        "types": "wrangler types --config .config/wrangler.jsonc src/worker-configuration.d.ts"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.127.0"
    },
    "packageManager": "pnpm@11.24.0"
}
